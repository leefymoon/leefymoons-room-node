{% extends "templates/rss.njk" %}

{% block feedItems %}
    {% for blogPost in blogs %}
    <item>
        <title>#{{ blogPost.id }} // {{ blogPost.title }}</title>
        <link>https://leefymoons-room.net/blog.html#{{ blogPost.id }}</link>
        <guid isPermaLink="true">https://leefymoons-room.net/blog.html#{{ blogPost.id }}</guid>
        <pubdate>{{ blogPost.rssDate }}</pubDate>
    </item>
    {% endfor %}
{% endblock %}